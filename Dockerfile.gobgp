# Standalone GoBGP daemon used as a third e2e BGP peer (IPv4 + IPv6).
# The embedded GoBGP in pathosd is v4.8.0, so build the matching gobgpd.
FROM golang:1.26-alpine AS builder
WORKDIR /build
RUN CGO_ENABLED=0 go install github.com/osrg/gobgp/v4/cmd/gobgpd@v4.8.0

FROM alpine:3.21
RUN apk add --no-cache ca-certificates busybox
COPY --from=builder /go/bin/gobgpd /usr/local/bin/gobgpd
# Config is templated by the pod wrapper; gRPC API listens on :50051.
ENTRYPOINT ["gobgpd"]