[Unit]
Description=pathosd BGP VIP announcer
After=network-online.target
Wants=network-online.target
# Optional ordering after a systemd-networkd dummy interface that holds the
# VIPs (contrib/systemd/dummy-vip/). Pure After=: it only takes effect when
# something starts that unit, e.g. the drop-in shipped with the example.
After=systemd-networkd-wait-online@dummy-vip.service

[Service]
# pathosd sends READY=1 once BGP and the HTTP API are up, STATUS= with a
# VIP/peer summary on every state change, and STOPPING=1 on shutdown.
Type=notify
User=pathosd
Group=pathosd

# Defaults, overridable without editing the unit: set PATHOSD_CONFIG (e.g. a
# .yaml file) or GOMAXPROCS in /etc/default/pathosd (Debian) or
# /etc/sysconfig/pathosd (EL), or in a `systemctl edit pathosd` drop-in.
# One OS thread is plenty for a health checker with a few BGP sessions.
Environment=PATHOSD_CONFIG=/etc/pathosd/pathosd.toml
Environment=GOMAXPROCS=1
EnvironmentFile=-/etc/default/pathosd
EnvironmentFile=-/etc/sysconfig/pathosd

ExecStartPre=/usr/bin/pathosd validate --config ${PATHOSD_CONFIG}
ExecStart=/usr/bin/pathosd run --config ${PATHOSD_CONFIG}

Restart=on-failure
RestartSec=5s

# CAP_NET_RAW:         ICMP ping health checks
# CAP_NET_BIND_SERVICE: bind BGP port 179 (<1024) as non-root
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# /run/pathosd is created by systemd at startup (mode 0750, owned by pathosd)
RuntimeDirectory=pathosd
RuntimeDirectoryMode=0750

# Hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
