# Environment for pathosd.service. Values here override the unit's defaults;
# restart the service after a change.

# Configuration file: YAML (.yaml/.yml) or TOML (.toml).
#PATHOSD_CONFIG=/etc/pathosd/pathosd.yaml

# Go scheduler threads. The unit defaults to 1, which covers a health checker
# with a few BGP sessions; raise it for many checks with short intervals.
#GOMAXPROCS=2
